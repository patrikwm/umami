# =============================================================================
# UMAMI ANALYTICS - ENVIRONMENT CONFIGURATION
# =============================================================================
# Complete .env configuration file for Umami Analytics
# Copy this file to .env and update with your actual values
# Documentation: https://umami.is/docs

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# PostgreSQL connection string (REQUIRED)
# Format: postgresql://username:password@host:port/database
# Examples:
#   Local: postgresql://umami:umami@localhost:5432/umami
#   Remote: postgresql://user:pass@db.example.com:5432/umami
#   SSL: postgresql://user:pass@db.example.com:5432/umami?sslmode=require
DATABASE_URL=postgresql://username:password@localhost:5432/umami

# =============================================================================
# SECURITY & AUTHENTICATION (REQUIRED)
# =============================================================================

# Application Secret (REQUIRED)
# Random string (min 32 characters) for JWT signing and encryption
# Generate with: openssl rand -base64 32
APP_SECRET=your-random-secret-key-here-min-32-chars

# Auth.js Secret (REQUIRED for OIDC/OAuth)
# Random string (min 32 characters) for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here-min-32-chars

# Application URL (REQUIRED for OIDC/OAuth)
# The public URL where your Umami instance is hosted
# Used as callback URL for OIDC/OAuth providers
# Examples:
#   Development: http://localhost:3000
#   Production: https://analytics.example.com
AUTH_URL=http://localhost:3000

# =============================================================================
# SESSION CONFIGURATION (OPTIONAL)
# =============================================================================

# Session duration in seconds (optional, default: 86400 = 24 hours)
# Examples:
#   1 hour: 3600
#   24 hours: 86400
#   7 days: 604800
#   30 days: 2592000
SESSION_DURATION=86400

# =============================================================================
# AUTHENTICATION PROVIDERS (OPTIONAL)
# =============================================================================

# NOTE: You can configure OIDC providers in two ways:
# 1. Environment variables (for a single provider) - shown below
# 2. Database management (for multiple providers) - use Admin UI

# --- Local Username/Password Login ---
# Set to 'true' to disable local login (SSO-only mode)
# Default: false (local login enabled)
DISABLE_LOCAL_LOGIN=false

# --- OIDC Auto-Create Users ---
# Allow automatic user creation on first OIDC login
# Set to 'false' to require manual user provisioning by admin
# Default: true
OIDC_AUTO_CREATE=true

# =============================================================================
# GENERIC OIDC PROVIDER (OPTIONAL)
# =============================================================================
# Configure a single OIDC provider via environment variables
# For MULTIPLE providers (Keycloak + Okta + Google, etc.), use the Admin UI instead
# Supports: Authentik, Keycloak, Okta, Entra ID, GitLab, Generic OIDC

# Provider display name (shown on login page)
OIDC_NAME=Authentik

# Provider ID (lowercase, used in URLs)
# Must match pattern: ^[a-z0-9-]+$
OIDC_ID=authentik

# OIDC Issuer URL (auto-discovery endpoint)
# The provider's OIDC configuration is loaded from {ISSUER}/.well-known/openid-configuration
# Examples:
#   Authentik: https://auth.example.com/application/o/umami/
#   Keycloak: https://keycloak.example.com/realms/myrealm
#   Okta: https://dev-123456.okta.com/oauth2/default
#   Entra ID: https://login.microsoftonline.com/{tenant-id}/v2.0
#   GitLab: https://gitlab.com (or self-hosted: https://gitlab.example.com)
OIDC_ISSUER=https://auth.example.com/application/o/umami/

# Client ID (from your OIDC provider)
OIDC_CLIENT_ID=your-client-id-here

# Client Secret (from your OIDC provider)
OIDC_CLIENT_SECRET=your-client-secret-here

# OAuth Scopes (space-separated)
# Default: openid profile email
# For groups/roles: openid profile email groups
OIDC_SCOPE=openid profile email groups

# Manual Endpoints (OPTIONAL - only for OAuth 2.0 providers)
# Required for: GitHub, Discord, Slack (providers without auto-discovery)
# Leave empty for standard OIDC providers (Authentik, Keycloak, Okta, etc.)
#OIDC_AUTH_URL=https://auth.example.com/application/o/authorize/
#OIDC_TOKEN_URL=https://auth.example.com/application/o/token/
#OIDC_USERINFO_URL=https://auth.example.com/application/o/userinfo/

# =============================================================================
# GOOGLE OAUTH (OPTIONAL)
# =============================================================================
# Quick setup for Google Workspace / Google accounts
# Get credentials: https://console.cloud.google.com/apis/credentials
# Redirect URI: {AUTH_URL}/api/auth/callback/google

#AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
#AUTH_GOOGLE_SECRET=your-google-client-secret

# =============================================================================
# GITHUB OAUTH (OPTIONAL)
# =============================================================================
# Quick setup for GitHub organization authentication
# Get credentials: https://github.com/settings/developers
# Redirect URI: {AUTH_URL}/api/auth/callback/github

#AUTH_GITHUB_ID=your-github-client-id
#AUTH_GITHUB_SECRET=your-github-client-secret

# =============================================================================
# ROLE & TEAM MAPPING (OPTIONAL - OIDC/OAuth only)
# =============================================================================
# Map OIDC groups claim to Umami roles and teams
# Configure these in the Admin UI for each provider

# Example role mapping (configured per provider in Admin UI):
# - Users in "umami-admins" group → Admin role
# - Users in "umami-viewers" group → View-only role
# - All other users → User role (default)

# Example team mapping (configured per provider in Admin UI):
# - Users in "engineering" group → Added to "Engineering Team"
# - Users in "marketing" group → Added to "Marketing Team"

# =============================================================================
# REDIS (OPTIONAL - RECOMMENDED FOR PRODUCTION)
# =============================================================================
# Redis for session storage, caching, and rate limiting
# Improves performance and enables horizontal scaling
# Format: redis://[username:password@]host:port[/database]

# Examples:
#   Local: redis://localhost:6379
#   With password: redis://:password@localhost:6379
#   Remote: redis://redis.example.com:6379/0
#   SSL/TLS: rediss://redis.example.com:6380
#REDIS_URL=redis://localhost:6379

# =============================================================================
# CLICKHOUSE (OPTIONAL - FOR ANALYTICS AT SCALE)
# =============================================================================
# ClickHouse for high-performance analytics queries
# Recommended for high-traffic sites (millions of events/day)
# Requires ClickHouse server installation

# ClickHouse connection URL
# Format: http://host:port[/database]
# Examples:
#   Local: http://localhost:8123
#   Remote: http://clickhouse.example.com:8123/umami
#   With auth: http://user:password@clickhouse.example.com:8123/umami
#CLICKHOUSE_URL=http://localhost:8123/umami

# =============================================================================
# FEATURE FLAGS (OPTIONAL)
# =============================================================================

# Disable all login (API-only mode)
# Set to 'true' to disable the web UI login entirely
#DISABLE_LOGIN=false

# Disable entire web UI (API-only mode)
# Set to 'true' to disable the web interface (headless analytics)
#DISABLE_UI=false

# Cloud mode (SaaS multi-tenant mode)
# Set to 'true' for Umami Cloud deployments
# Enables tenant isolation and billing features
#CLOUD_MODE=false

# Disable bot detection
# Set to 'true' to disable automatic bot filtering
#DISABLE_BOT_CHECK=false

# Enable debug logging
# Set to 'true' for verbose logging (development only)
#DEBUG=false

# =============================================================================
# EXTERNAL INTEGRATIONS (OPTIONAL)
# =============================================================================

# Kafka for event streaming (requires ClickHouse)
# Used for real-time event processing and analytics
#KAFKA_BROKER=localhost:9092
#KAFKA_TOPIC=umami-events

# =============================================================================
# ADVANCED CONFIGURATION (OPTIONAL)
# =============================================================================

# Custom base path (for reverse proxy setups)
# Example: /analytics (app will be available at https://example.com/analytics)
#BASE_PATH=

# Hostname (for multi-domain setups)
# Override the hostname for cookie domain
#HOSTNAME=analytics.example.com

# Port (default: 3000)
# Override the default port
#PORT=3000

# Force SSL/HTTPS
# Set to 'true' to force HTTPS redirects
#FORCE_SSL=false

# Allowed domains (CORS)
# Comma-separated list of domains allowed to send tracking data
#ALLOWED_DOMAINS=example.com,www.example.com

# Remove trailing slash from URLs
# Set to 'true' to normalize URLs by removing trailing slashes
#REMOVE_TRAILING_SLASH=false

# Use UUID v7 instead of v4
# Set to 'true' to use time-ordered UUIDs (better database performance)
#USE_UUIDV7=true

# =============================================================================
# TELEMETRY (OPTIONAL)
# =============================================================================

# Disable anonymous telemetry
# Umami collects anonymous usage data to improve the product
# Set to 'true' to opt out
#DISABLE_TELEMETRY=false

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# --- Example 1: Local Development ---
# DATABASE_URL=postgresql://umami:umami@localhost:5432/umami
# APP_SECRET=development-secret-min-32-characters-long
# AUTH_SECRET=development-auth-secret-min-32-char
# AUTH_URL=http://localhost:3000

# --- Example 2: Production with Authentik OIDC ---
# DATABASE_URL=postgresql://umami:secure-password@db.example.com:5432/umami
# APP_SECRET=wJa9kL2mN3oP4qR5sT6uV7wX8yZ9aB0cD1eF2gH3i
# AUTH_SECRET=4jK5lM6nN7oP8qR9sT0uV1wX2yZ3aB4cD5eF6gH7i
# AUTH_URL=https://analytics.example.com
# OIDC_NAME=Authentik
# OIDC_ID=authentik
# OIDC_ISSUER=https://auth.example.com/application/o/umami/
# OIDC_CLIENT_ID=umami-analytics-client
# OIDC_CLIENT_SECRET=very-long-client-secret-from-authentik
# OIDC_SCOPE=openid profile email groups
# REDIS_URL=redis://:redis-password@redis.example.com:6379
# DISABLE_LOCAL_LOGIN=false
# OIDC_AUTO_CREATE=true
# SESSION_DURATION=86400

# --- Example 3: Production with Multiple OIDC Providers ---
# DATABASE_URL=postgresql://umami:password@db.example.com:5432/umami
# APP_SECRET=secure-random-secret-32-chars-minimum
# AUTH_SECRET=another-secure-random-secret-32-chars
# AUTH_URL=https://analytics.example.com
# REDIS_URL=redis://redis.example.com:6379
# CLICKHOUSE_URL=http://clickhouse.example.com:8123/umami
# DISABLE_LOCAL_LOGIN=false
# OIDC_AUTO_CREATE=true
# Note: Configure Keycloak, Okta, Google, GitHub in Admin UI

# --- Example 4: SSO-Only Mode (No Local Login) ---
# DATABASE_URL=postgresql://umami:password@db.example.com:5432/umami
# APP_SECRET=secure-secret-here-min-32-characters
# AUTH_SECRET=auth-secret-here-min-32-characters
# AUTH_URL=https://analytics.example.com
# OIDC_NAME=Okta
# OIDC_ID=okta
# OIDC_ISSUER=https://dev-123456.okta.com/oauth2/default
# OIDC_CLIENT_ID=okta-client-id
# OIDC_CLIENT_SECRET=okta-client-secret
# OIDC_SCOPE=openid profile email groups
# DISABLE_LOCAL_LOGIN=true
# OIDC_AUTO_CREATE=true
# REDIS_URL=redis://redis.example.com:6379

# =============================================================================
# DOCKER COMPOSE EXAMPLE
# =============================================================================
# For docker-compose.yml, use this .env file in the same directory
# The compose file will automatically load these environment variables
# See docker-compose.yml for service definitions

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# Problem: OIDC provider not showing on login page
# Solution: Check AUTH_URL matches your actual URL, restart server

# Problem: "Email not verified" error
# Solution: Set provider as "trusted" in Admin UI, or ensure IdP sends email_verified=true

# Problem: Users created but no role mapping
# Solution: Configure adminGroup/viewOnlyGroup in Admin UI per provider

# Problem: Database connection failed
# Solution: Verify DATABASE_URL format, check PostgreSQL is running

# Problem: Session expired too quickly
# Solution: Increase SESSION_DURATION value (in seconds)

